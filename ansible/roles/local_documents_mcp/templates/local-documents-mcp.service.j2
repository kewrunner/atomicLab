[Unit]
Description=Read-only Local Documents MCP
After=network.target

[Service]
Type=simple
User={{ local_documents_mcp_user }}
Group={{ local_documents_mcp_group }}
WorkingDirectory={{ local_documents_mcp_install_dir }}
EnvironmentFile={{ local_documents_mcp_config_dir }}/local-documents-mcp.env
ExecStart={{ local_documents_mcp_install_dir }}/.venv/bin/python {{ local_documents_mcp_install_dir }}/server.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths={{ mcp_canonical_directory.stdout }}
ReadWritePaths={{ local_documents_mcp_install_dir }}
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
