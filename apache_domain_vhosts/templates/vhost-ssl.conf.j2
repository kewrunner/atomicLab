{{ apache_management_marker }}
<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName {{ apache_domain }}
    ProxyPreserveHost On

    RewriteEngine On
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteCond %{HTTP:Connection} upgrade [NC]
    RewriteRule ^/(.*)$ {{ apache_websocket_backend }}/$1 [P,L]

    ProxyPass        / {{ apache_proxy_backend }}/
    ProxyPassReverse / {{ apache_proxy_backend }}/

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/{{ apache_domain }}/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/{{ apache_domain }}/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    ErrorLog ${APACHE_LOG_DIR}/{{ apache_domain }}-ssl-error.log
    CustomLog ${APACHE_LOG_DIR}/{{ apache_domain }}-ssl-access.log combined
</VirtualHost>
</IfModule>
